git# LLM Configuration
LLM_TYPE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=2048

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./models/vectorstore

# Data Paths
DATA_DIR=./data/documents
PROCESSED_DATA_DIR=./data/processed
EMBEDDING_DIR=./data/embeddings

# Chunking Strategy
# Selects chunker + FAISS index + retrieval path end-to-end.
# flat_baseline (alias: flat_512) | hierarchical
CHUNK_STRATEGY=flat_baseline
CHUNK_SIZE=1024
CHUNK_OVERLAP=150

# OCR text repair before chunking (hyphenation, wrapped lines, page numbers,
# repeated headers/footers). Set to false to reproduce pre-cleanup output.
OCR_CLEANUP=true

# Hierarchical chunking. Sizes are CHARACTERS, not tokens (~3.5 chars/token for
# Serbian): parents ~1024-1536 tokens, children ~256-384 tokens.
HIER_PARENT_SIZE=4500
HIER_PARENT_MIN=3600
HIER_CHILD_SIZE=1200
HIER_CHILD_MIN=900
HIER_CHILD_OVERLAP_RATIO=0.12
HIER_EXPAND_TO_PARENT=true

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.7
# Character budget for the LLM context. Hold this FIXED across strategies when
# A/B testing, otherwise the comparison measures context budget, not chunking.
CONTEXT_MAX_LENGTH=6000

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Web Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=false

# Database (Optional)
# DATABASE_URL=sqlite:///./rag_system.db

# Cloud LLM APIs (Optional)
# OPENAI_API_KEY=sk-...
# HUGGINGFACE_API_KEY=hf_...

# Chatbot Integrations
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# DISCORD_BOT_TOKEN=your_discord_token_here
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# Development
ENVIRONMENT=development
DEBUG=true
